# ============================================================
# @9thround/site — public website environment
# Copy to .env.local for local dev. Real values are set ONLY in this
# app's OWN Vercel project (never in @9thround/web's project, never
# committed). Nothing here changes the internal Web App's environment.
# ============================================================

# --- Public (safe to expose to the browser) ---
# MUST include `www`, and MUST be set in Vercel. The apex domain 308s to the
# www host, so a canonical naming the apex points at a redirect. If this is
# left unset in production the build falls back to its default and
# robots.txt can end up advertising a localhost sitemap URL — which is
# exactly what happened on the previous deployment.
NEXT_PUBLIC_SITE_URL=https://www.9throundegypt.com

# Click-to-contact. Digits only, international format without "+".
# e.g. 20xxxxxxxxxx  (Egypt). Leave blank to hide the CTA until confirmed.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_PHONE_NUMBER=

# Product analytics (optional). A SEPARATE PostHog project for the site is
# recommended so marketing data never mixes with the internal product's.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# Bot protection for the trial form (Cloudflare Turnstile). Optional but
# recommended before launch. If unset, the form still works (honeypot +
# rate-limit only).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Server only (NEVER prefixed NEXT_PUBLIC_, never sent to the browser) ---
# Used exclusively by app/api/trial/route.ts to insert ONE row into the
# EXISTING `leads` table. This is the same Supabase project as the internal
# app; the site only ever writes a lead, never reads anything.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The branch every website lead is attached to (single branch today).
# Get this id from the internal system's `branches` table.
NINTH_ROUND_DEFAULT_BRANCH_ID=

# Turnstile secret (server-side verification). Pairs with the site key above.
TURNSTILE_SECRET_KEY=

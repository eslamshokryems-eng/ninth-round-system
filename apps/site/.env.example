# Copy to .env.local for local dev. This app has no Supabase dependency
# yet — it is fully static/public. Do not add SUPABASE_SERVICE_ROLE_KEY or
# any other secret here; this app must never hold private credentials.

NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Analytics/ad tracking — each provider stays fully disabled (no script
# loaded, no console errors) until its own ID is set. Leave unset in local
# dev unless you're specifically testing tracking.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GTM_ID=

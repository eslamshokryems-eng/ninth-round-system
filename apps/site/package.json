{
  "name": "@9thround/site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/localize-next.mjs && node ./node_modules/next/dist/bin/next dev -p 3001",
    "build": "node scripts/localize-next.mjs && node ./node_modules/next/dist/bin/next build",
    "start": "node scripts/localize-next.mjs && node ./node_modules/next/dist/bin/next start -p 3001",
    "lint": "eslint .",
    "typecheck": "node scripts/localize-next.mjs && tsc --noEmit"
  },
  "dependencies": {
    "next": "15.5.24",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@9thround/config": "workspace:*",
    "typescript": "^5.5.0",
    "postcss": "^8.4.47",
    "autoprefixer": "^10.4.20",
    "tailwindcss": "^3.4.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/node": "^20.14.0"
  }
}

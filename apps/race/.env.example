# THE NINTH — its OWN Supabase project (never the gym-management project).
NEXT_PUBLIC_SUPABASE_URL=https://<race-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<race-project anon key>
# Server-only. Never prefix with NEXT_PUBLIC_, never import in a client component, never commit.
# Used only by admin scripts (creating staff accounts). The web app does not need it.
SUPABASE_SERVICE_ROLE_KEY=

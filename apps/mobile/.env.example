# Copy this file to `.env` in this same folder (apps/mobile/.env) — Expo
# only auto-loads `.env` files from the app's own directory, not the
# monorepo root. Never commit the real `.env` (already gitignored).
#
# Where to get these two values: create a Supabase project, then
# Project Settings → API → "Project URL" and "anon public" key.
# See docs/phase-1/13-local-setup.md for the full step-by-step.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

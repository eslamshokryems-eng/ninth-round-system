{
  "name": "9th-round",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "supabase db push",
    "db:types": "supabase gen types typescript --local > packages/database-types/src/index.ts",
    "postinstall": "node scripts/fix-next-react-dedup.mjs"
  },
  "devDependencies": {
    "@9thround/config": "workspace:*",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "prettier": "^3.3.0",
    "eslint": "^9.0.0"
  },
  "pnpm": {
    "overrides": {
      "styled-jsx>react": "18.2.0"
    }
  }
}

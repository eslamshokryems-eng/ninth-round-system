# Copy to .env and fill in per environment (development/staging/production).
# Never commit a real .env file — see docs/07-security-plan.md §7.6.

# --- Web app ---
# Production: https://9throundegypt.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Cloudflare ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=

# --- Firebase (push) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- AI Coach ---
ANTHROPIC_API_KEY=

# --- Observability ---
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_KEY=

# --- Rate limiting / cache ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Login Verification + Trusted Devices (apps/web, device-verification-email) ---
# Server-only. RESEND_API_KEY is a secret; RESEND_FROM_EMAIL is the "from"
# address for OTP emails and can be public. The OTP destination itself is
# NOT an env var — a super_admin sets it under Security in the app, stored
# in the security_settings table.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Device verification (staff new-device gate) ---
# REQUIRED for the gate to work: a random secret of at least 32 characters,
# used as the HMAC key for verification codes. Generate one with
#   openssl rand -hex 32
# Server-only; never prefix with NEXT_PUBLIC_. With it missing the device
# routes fail closed (HTTP 500) rather than fall back to an unkeyed hash.
# Rotating it simply invalidates any code issued in the last 5 minutes.
DEVICE_VERIFICATION_PEPPER=
# Local development ONLY: point at tools/local-dev-stack/mail-sink.mjs. Ignored
# when NODE_ENV=production.
# RESEND_API_URL=http://127.0.0.1:54325

# Local development behind a remote preview ONLY (see tools/local-dev-stack/README.md):
# NEXT_PUBLIC_SUPABASE_URL=same-origin, SUPABASE_INTERNAL_URL=<gateway>, LOCAL_GATEWAY_URL=<gateway>
# Never set these in a deployed environment; use the real Supabase project URL.
